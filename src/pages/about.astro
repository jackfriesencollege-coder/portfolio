---
import Base from '../layouts/Base.astro';
import Slideshow from '../components/Slideshow.astro';
import { Content as AboutBody } from '../content/about.md';

import longsPeak from '../assets/about/longs-peak.jpg';
import ridgeHike from '../assets/about/ridge-hike.jpg';
import skiing from '../assets/about/skiing.jpg';
import buggy from '../assets/about/buggy.jpg';
import engineBay from '../assets/about/engine-bay.jpg';
import truckBrakes from '../assets/about/truck-brakes.jpg';
import truckShocks from '../assets/about/truck-shocks.jpg';
import cylinderHead from '../assets/about/cylinder-head.jpg';
import brakeRotor from '../assets/about/brake-rotor.jpg';

/* Everyone shown here has agreed to appear on the site. The one photo where
   somebody hasn't (the movie screen project) is covered with a smiley instead. */
const slides = [
  { src: longsPeak, alt: 'On the summit of Longs Peak with a hand-lettered sign, 14,259 feet' },
  { src: ridgeHike, alt: 'Resting on a rocky ridge, looking out over an alpine valley while two hikers climb the trail below' },
  { src: skiing, alt: 'Skiing high above a valley, with the snow-covered Rockies behind' },
  { src: buggy, alt: 'Driving a dune buggy down a dirt road, trailing dust' },
  { src: engineBay, alt: 'Leaning over the open engine bay of a blue car, using a cordless driver on the valve cover bolts' },
  { src: truckBrakes, alt: 'Sitting on a garage floor beside a red Toyota Tundra, working on the front brake assembly with tools spread around' },
  { src: truckShocks, alt: 'Kneeling beside a red pickup in the driveway, smiling, with the old and new shock absorbers laid out on cardboard' },
  { src: cylinderHead, alt: 'Inspecting a four-cylinder engine head laid on a red shop towel in the garage' },
  { src: brakeRotor, alt: 'Torquing the caliper bolts on a new slotted and drilled brake rotor' },
];
---

<Base
  title="About"
  description="Why a Colorado gearhead ended up in emissions and aerosol research."
>
  <section class="wrap section">
    <p class="eyebrow">About</p>

    <div class="intro">
      <Slideshow slides={slides} interval={5000} />

      <div class="prose">
        <AboutBody />
      </div>
    </div>
  </section>
</Base>

<style>
  /* The photos lead on narrow screens and move alongside the text once there's
     room, so the page doesn't open with a wall of image on a phone. */
  .intro {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 56rem) {
    .intro {
      grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  /* The first heading sits level with the top of the photo frame. */
  .prose :global(h1:first-child) {
    margin-top: -0.35rem;
  }
</style>
